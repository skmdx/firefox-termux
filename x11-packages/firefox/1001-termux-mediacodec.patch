+    android = dlopen("libandroid.so", RTLD_NOW | RTLD_LOCAL);
+    media = dlopen("libmediandk.so", RTLD_NOW | RTLD_LOCAL);
+    egl = dlopen("/system/lib64/libEGL.so", RTLD_NOW | RTLD_LOCAL);
+    gl = dlopen("/system/lib64/libGLESv2.so", RTLD_NOW | RTLD_LOCAL);
+    if (!android || !media || !egl || !gl) return false;
+#define LOAD(lib, name)                                             \
+  f##name = reinterpret_cast<decltype(f##name)>(dlsym(lib, #name)); \
+  if (!f##name) return false;
+#define A(name) LOAD(android, name)
+    ANDROID_FUNCTIONS(A)
+#undef A
+#define A(name) LOAD(media, name)
+    MEDIA_FUNCTIONS(A)
+#undef A
+#define A(name) LOAD(egl, name)
+    EGL_FUNCTIONS(A)
+#undef A
+#define A(name) LOAD(gl, name)
+    GL_FUNCTIONS(A)
+#undef A
+#undef LOAD
+#define EXT(member, name)                                                \
+  member = reinterpret_cast<decltype(member)>(feglGetProcAddress(name)); \
+  if (!member) return false;
+    EXT(getClientBuffer, "eglGetNativeClientBufferANDROID")
+    EXT(createImage, "eglCreateImageKHR")
+    EXT(destroyImage, "eglDestroyImageKHR")
+    EXT(imageTarget, "glEGLImageTargetTexture2DOES")
+    EXT(createSync, "eglCreateSyncKHR")
+    EXT(destroySync, "eglDestroySyncKHR")
+    EXT(waitSync, "eglWaitSyncKHR")
+    EXT(dupFence, "eglDupNativeFenceFDANDROID")
+#undef EXT
+    return true;
+  }
+
+  bool Current() { return feglMakeCurrent(display, pbuffer, pbuffer, context); }
+
+  GLuint Shader(GLenum type, const char* text) {
+    GLuint shader = fglCreateShader(type);
+    fglShaderSource(shader, 1, &text, nullptr);
+    fglCompileShader(shader);
+    GLint compiled = 0;
+    fglGetShaderiv(shader, GL_COMPILE_STATUS, &compiled);
+    if (!compiled) {
+      fglDeleteShader(shader);
+      return 0;
+    }
+    return shader;
+  }
+
+  bool InitGL() {
+    display = feglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (display == EGL_NO_DISPLAY || !feglInitialize(display, nullptr, nullptr))
+      return false;
+    const EGLint configAttrs[] = {EGL_SURFACE_TYPE,
+                                  EGL_PBUFFER_BIT,
+                                  EGL_RENDERABLE_TYPE,
+                                  EGL_OPENGL_ES2_BIT,
+                                  EGL_RED_SIZE,
+                                  8,
+                                  EGL_GREEN_SIZE,
+                                  8,
+                                  EGL_BLUE_SIZE,
+                                  8,
+                                  EGL_ALPHA_SIZE,
+                                  8,
+                                  EGL_NONE};
+    EGLConfig config;
+    EGLint count = 0;
+    if (!feglChooseConfig(display, configAttrs, &config, 1, &count) || !count)
+      return false;
+    const EGLint contextAttrs[] = {EGL_CONTEXT_CLIENT_VERSION, 2, EGL_NONE};
+    context = feglCreateContext(display, config, EGL_NO_CONTEXT, contextAttrs);
+    const EGLint surfaceAttrs[] = {EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE};
+    pbuffer = feglCreatePbufferSurface(display, config, surfaceAttrs);
+    if (context == EGL_NO_CONTEXT || pbuffer == EGL_NO_SURFACE || !Current())
+      return false;
+    const char* vs =
+        "attribute vec2 pos; varying vec2 uv; uniform vec4 crop;"
+        "void "
+        "main(){gl_Position=vec4(pos,0.,1.);uv=(pos*.5+.5)*crop.zw+crop.xy;}";
+    const char* fs =
+        "#extension GL_OES_EGL_image_external : require\n"
+        "precision mediump float; varying vec2 uv; uniform samplerExternalOES "
+        "tex;"
+        "void main(){gl_FragColor=texture2D(tex,uv);}";
+    GLuint vertex = Shader(GL_VERTEX_SHADER, vs),
+           fragment = Shader(GL_FRAGMENT_SHADER, fs);
+    auto cleanup = MakeScopeExit([&] {
+      fglDeleteShader(vertex);
+      fglDeleteShader(fragment);
+    });
+    if (!vertex || !fragment) return false;
+    program = fglCreateProgram();
+    fglAttachShader(program, vertex);
+    fglAttachShader(program, fragment);
+    fglBindAttribLocation(program, 0, "pos");
+    fglLinkProgram(program);
+    GLint linked = 0;
+    fglGetProgramiv(program, GL_LINK_STATUS, &linked);
+    feglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    return linked;
+  }
+
+  // Public NDK handle transfer, as used by Termux:X11's DRI3 export.
+  int ExportFd(AHardwareBuffer* buffer) {
+    int sockets[2];
+    if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets)) return -1;
+    auto cleanup = MakeScopeExit([&] {
+      close(sockets[0]);
+      close(sockets[1]);
+    });
+    if (fAHardwareBuffer_sendHandleToUnixSocket(buffer, sockets[0])) return -1;
+    shutdown(sockets[0], SHUT_WR);
+    int found = -1;
+    char data[4096];
+    alignas(cmsghdr) char control[CMSG_SPACE(32 * sizeof(int))];
+    iovec iov{data, sizeof(data)};
+    for (;;) {
+      msghdr msg{};
+      msg.msg_iov = &iov;
+      msg.msg_iovlen = 1;
+      msg.msg_control = control;
+      msg.msg_controllen = sizeof(control);
+      if (recvmsg(sockets[1], &msg, MSG_CMSG_CLOEXEC) <= 0) break;
+      for (cmsghdr* c = CMSG_FIRSTHDR(&msg); c; c = CMSG_NXTHDR(&msg, c)) {
+        if (c->cmsg_level != SOL_SOCKET || c->cmsg_type != SCM_RIGHTS) continue;
+        int* fds = reinterpret_cast<int*>(CMSG_DATA(c));
+        size_t count = (c->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+        for (size_t i = 0; i < count; ++i) {
+          char path[64], target[256];
+          snprintf(path, sizeof(path), "/proc/self/fd/%d", fds[i]);
+          ssize_t len = readlink(path, target, sizeof(target) - 1);
+          if (len > 0) {
+            target[len] = 0;
+            if (found < 0 &&
+                (strstr(target, "dmabuf") || strstr(target, "dma_heap") ||
+                 strstr(target, "/dev/dma"))) {
+              found = fds[i];
+              continue;
+            }
+          }
+          close(fds[i]);
+        }
+      }
+    }
+    return found;
+  }
+
+  ~Impl() {
+    if (reader) fAImageReader_delete(reader);
+    for (auto& slot : outputs) {
+      if (slot.buffer) fAHardwareBuffer_release(slot.buffer);
+    }
+    if (context != EGL_NO_CONTEXT && Current()) {
+      if (program) fglDeleteProgram(program);
+      feglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    }
+    if (pbuffer != EGL_NO_SURFACE) feglDestroySurface(display, pbuffer);
+    if (context != EGL_NO_CONTEXT) feglDestroyContext(display, context);
+    if (display != EGL_NO_DISPLAY) feglTerminate(display);
+    if (gl) dlclose(gl);
+    if (egl) dlclose(egl);
+    if (media) dlclose(media);
+    if (android) dlclose(android);
+  }
+};
