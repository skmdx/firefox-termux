+                 &end,
+                 &offset,
+                 &mapMajor,
+                 &mapMinor,
+                 &inode) != 6 ||
+          inode != st.st_ino || mapMajor != major(st.st_dev) ||
+          mapMinor != minor(st.st_dev))
+        continue;
+      for (int i = 0; i < 2; ++i) {
+        auto address = reinterpret_cast<uintptr_t>(planes.planes[i].data);
+        if (address >= start && address < end) {
+          auto planeOffset = offset + address - start;
+          if (planeOffset > UINT32_MAX)
+            return nullptr;
+          layout.offset[i] = planeOffset;
+          found[i] = true;
+        }
+      }
+    }
+    if (!found[0] || !found[1]) {
+      LOG("Decoder planes do not map the exported dma-buf inode {}", st.st_ino);
+      return nullptr;
+    }
+    LOG("Decoder allocation inode {}: NV12 strides {} {} offsets {} {}",
+        st.st_ino,
+        layout.stride[0],
+        layout.stride[1],
+        layout.offset[0],
+        layout.offset[1]);
+    layouts.push_back(std::move(layout));
+    return &layouts.back();
+  }
+  void ReleaseUnused()
+  {
+    for (auto it = leases.begin(); it != leases.end();) {
+      if (!it->surface->IsGlobalRefSet()) {
+        fAImage_deleteAsync(it->image, -1);
+        it = leases.erase(it);
+      } else
+        ++it;
+    }
+  }
+  ~Impl()
+  {
+    // The codec is shut down before its reader. Imported dma-buf fds retain
+    // allocations still displayed after shutdown; the producer cannot reuse
+    // them.
+    for (auto& lease : leases)
+      fAImage_deleteAsync(lease.image, -1);
+    if (reader)
+      fAImageReader_delete(reader);
+    if (media)
+      dlclose(media);
+    if (android)
+      dlclose(android);
+  }
+};
+
+TermuxMediaCodecSurface::TermuxMediaCodecSurface()
+  : m(MakeUnique<Impl>())
+{
+}
+TermuxMediaCodecSurface::~TermuxMediaCodecSurface() = default;
+MediaResult
+TermuxMediaCodecSurface::Init(int aWidth, int aHeight)
+{
+  if (!m->Load() ||
+      m->fAImageReader_newWithUsage(aWidth,
+                                    aHeight,
+                                    AIMAGE_FORMAT_YUV_420_888,
+                                    AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+                                      AHARDWAREBUFFER_USAGE_CPU_READ_RARELY,
+                                    16,
+                                    &m->reader) != AMEDIA_OK ||
+      m->fAImageReader_getWindow(m->reader, &m->window) != AMEDIA_OK) {
+    return MediaResult(NS_ERROR_DOM_MEDIA_FATAL_ERR,
+                       RESULT_DETAIL("YUV AImageReader initialization failed"));
+  }
+  AImageReader_ImageListener listener{ m.get(), [](void* data, AImageReader*) {
+                                        auto* impl = static_cast<Impl*>(data);
+                                        std::lock_guard<std::mutex> lock(
+                                          impl->mutex);
+                                        impl->available.notify_one();
+                                      } };
+  m->fAImageReader_setImageListener(m->reader, &listener);
+  LOG("Direct YUV AImageReader ready {}x{}", aWidth, aHeight);
+  return NS_OK;
+}
+void*
+TermuxMediaCodecSurface::AcquireWindow()
+{
+  m->fANativeWindow_acquire(m->window);
+  return m->window;
+}
+void
+TermuxMediaCodecSurface::ReleaseUnusedImages()
+{
+  m->ReleaseUnused();
+}
+already_AddRefed<layers::Image>
+TermuxMediaCodecSurface::AcquireImage(int aWidth,
+                                      int aHeight,
+                                      gfx::YUVColorSpace aColorSpace,
+                                      gfx::ColorRange aColorRange)
+{
+  m->ReleaseUnused();
+  AImage* image = nullptr;
+  int acquireFd = -1;
+  {
+    std::unique_lock<std::mutex> lock(m->mutex);
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    for (;;) {
+      media_status_t status =
+        m->fAImageReader_acquireNextImageAsync(m->reader, &image, &acquireFd);
+      if (status == AMEDIA_OK)
+        break;
+      if (status != AMEDIA_IMGREADER_NO_BUFFER_AVAILABLE ||
+          m->available.wait_until(lock, deadline) == std::cv_status::timeout) {
+        LOG("AImageReader acquire failed {} outstanding {}",
+            static_cast<int>(status),
+            m->leases.size());
+        return nullptr;
+      }
+    }
+  }
+  UniqueFileHandle fence(acquireFd);
+  auto release =
+    MakeScopeExit([&] { m->fAImage_deleteAsync(image, fence.release()); });
+  AHardwareBuffer* buffer = nullptr;
+  AImageCropRect crop{};
+  if (m->fAImage_getHardwareBuffer(image, &buffer) != AMEDIA_OK ||
+      m->fAImage_getCropRect(image, &crop) != AMEDIA_OK)
+    return nullptr;
+  auto* layout = m->GetLayout(buffer, acquireFd);
+  if (!layout)
+    return nullptr;
+  if (crop.left % 2 || crop.top % 2 || crop.right - crop.left != aWidth ||
+      crop.bottom - crop.top != aHeight) {
+    LOG("Unsupported crop {} {} {} {} for {}x{}",
+        crop.left,
+        crop.top,
+        crop.right,
+        crop.bottom,
+        aWidth,
+        aHeight);
+    return nullptr;
+  }
+  uint32_t offsets[2] = {
+    layout->offset[0] + crop.top * layout->stride[0] + crop.left,
+    layout->offset[1] + (crop.top / 2) * layout->stride[1] + crop.left
+  };
+  RefPtr<DMABufSurfaceYUV> surface =
+    DMABufSurfaceYUV::CreateFromNV12(UniqueFileHandle(dup(layout->fd.get())),
+                                     std::move(fence),
+                                     aWidth,
+                                     aHeight,
+                                     layout->stride,
+                                     offsets);
+  surface->SetYUVColorSpace(aColorSpace);
+  surface->SetColorRange(aColorRange);
+  m->leases.push_back({ image, surface });
+  release.release();
+  LOG("Zero-copy NV12 {}x{} inode {} -> DMABuf {} outstanding {}",
+      aWidth,
+      aHeight,
+      layout->inode,
+      surface->GetUID(),
+      m->leases.size());
+  RefPtr<layers::Image> result = new layers::DMABUFSurfaceImage(surface);
+  return result.forget();
+}
