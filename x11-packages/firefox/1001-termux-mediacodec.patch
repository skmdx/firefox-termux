+TermuxMediaCodecSurface::TermuxMediaCodecSurface() : m(MakeUnique<Impl>()) {}
+TermuxMediaCodecSurface::~TermuxMediaCodecSurface() = default;
+
+MediaResult TermuxMediaCodecSurface::Init(int aWidth, int aHeight) {
+  if (!m->Load() || !m->InitGL()) {
+    return MediaResult(NS_ERROR_DOM_MEDIA_FATAL_ERR,
+                       RESULT_DETAIL("Android EGL initialization failed"));
+  }
+  if (m->fAImageReader_newWithUsage(aWidth, aHeight, AIMAGE_FORMAT_PRIVATE,
+                                    AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE, 4,
+                                    &m->reader) != AMEDIA_OK ||
+      m->fAImageReader_getWindow(m->reader, &m->window) != AMEDIA_OK) {
+    return MediaResult(NS_ERROR_DOM_MEDIA_FATAL_ERR,
+                       RESULT_DETAIL("AImageReader initialization failed"));
+  }
+  AImageReader_ImageListener listener{
+      m.get(), [](void* data, AImageReader*) {
+        auto* impl = static_cast<Impl*>(data);
+        std::lock_guard<std::mutex> lock(impl->mutex);
+        impl->available.notify_one();
+      }};
+  m->fAImageReader_setImageListener(m->reader, &listener);
+  LOG("Android EGL and PRIVATE AImageReader ready {}x{}", aWidth, aHeight);
+  return NS_OK;
+}
+
+void* TermuxMediaCodecSurface::AcquireWindow() {
+  m->fANativeWindow_acquire(m->window);
+  return m->window;
+}
+
+already_AddRefed<layers::Image> TermuxMediaCodecSurface::AcquireImage(
+    int aWidth, int aHeight) {
+  AImage* image = nullptr;
+  int acquireFd = -1;
+  {
+    std::unique_lock<std::mutex> lock(m->mutex);
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    for (;;) {
+      media_status_t status =
+          m->fAImageReader_acquireNextImageAsync(m->reader, &image, &acquireFd);
+      if (status == AMEDIA_OK) break;
+      if (status != AMEDIA_IMGREADER_NO_BUFFER_AVAILABLE ||
+          m->available.wait_until(lock, deadline) == std::cv_status::timeout) {
+        LOG("AImageReader acquire failed {}", static_cast<int>(status));
+        return nullptr;
+      }
+    }
+  }
+  int releaseFence = -1;
+  auto releaseImage =
+      MakeScopeExit([&] { m->fAImage_deleteAsync(image, releaseFence); });
+  if (!m->Current()) {
+    if (acquireFd >= 0) close(acquireFd);
+    return nullptr;
+  }
+  auto unbind = MakeScopeExit([&] {
+    m->feglMakeCurrent(m->display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                       EGL_NO_CONTEXT);
+  });
+  if (acquireFd >= 0) {
+    EGLint attrs[] = {EGL_SYNC_NATIVE_FENCE_FD_ANDROID, acquireFd, EGL_NONE};
+    EGLSyncKHR sync =
+        m->createSync(m->display, EGL_SYNC_NATIVE_FENCE_ANDROID, attrs);
+    if (sync == EGL_NO_SYNC_KHR) {
+      close(acquireFd);
+      return nullptr;
+    }
+    bool ok = m->waitSync(m->display, sync, 0);
+    m->destroySync(m->display, sync);
+    if (!ok) return nullptr;
+  }
+  AHardwareBuffer* input = nullptr;
+  if (m->fAImage_getHardwareBuffer(image, &input) != AMEDIA_OK) return nullptr;
+  AHardwareBuffer_Desc inputDesc{};
+  m->fAHardwareBuffer_describe(input, &inputDesc);
+  AImageCropRect crop{};
+  if (m->fAImage_getCropRect(image, &crop) != AMEDIA_OK) return nullptr;
+  AHardwareBuffer_Desc desc{};
+  desc.width = aWidth;
+  desc.height = aHeight;
+  desc.layers = 1;
+  desc.format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
+  // CPU access flags request a linear, interoperable RGBA allocation. No lock,
+  // mapping, pixel upload or readback occurs in this decoder path.
+  desc.usage = AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT |
+               AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+               AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN |
+               AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN;
+  Impl::OutputSlot* slot = nullptr;
+  auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+  do {
+    for (auto& candidate : m->outputs) {
+      if (!candidate.lastSurface || !candidate.lastSurface->IsGlobalRefSet()) {
+        slot = &candidate;
+        break;
+      }
+    }
+    if (slot) break;
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  } while (std::chrono::steady_clock::now() < deadline);
+  if (!slot) {
+    LOG("RGBA output pool is still in use");
+    return nullptr;
+  }
+  slot->lastSurface = nullptr;
+  if (slot->buffer &&
+      (slot->desc.width != desc.width || slot->desc.height != desc.height)) {
+    m->fAHardwareBuffer_release(slot->buffer);
+    slot->buffer = nullptr;
+    slot->fd.reset();
+  }
+  if (!slot->buffer) {
+    if (m->fAHardwareBuffer_allocate(&desc, &slot->buffer)) return nullptr;
+    m->fAHardwareBuffer_describe(slot->buffer, &slot->desc);
+    slot->fd.reset(m->ExportFd(slot->buffer));
+    LOG("Allocated RGBA pool slot {} {}x{}", slot - m->outputs.data(), aWidth,
+        aHeight);
+  }
+  if (!slot->fd) return nullptr;
+  AHardwareBuffer* output = slot->buffer;
+  desc = slot->desc;
+  EGLint imageAttrs[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+  EGLImageKHR src =
+      m->createImage(m->display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                     m->getClientBuffer(input), imageAttrs);
+  EGLImageKHR dst =
+      m->createImage(m->display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                     m->getClientBuffer(output), imageAttrs);
+  auto releaseEGL = MakeScopeExit([&] {
+    if (src != EGL_NO_IMAGE_KHR) m->destroyImage(m->display, src);
+    if (dst != EGL_NO_IMAGE_KHR) m->destroyImage(m->display, dst);
+  });
+  if (src == EGL_NO_IMAGE_KHR || dst == EGL_NO_IMAGE_KHR) return nullptr;
+  GLuint textures[2], fbo;
+  m->fglGenTextures(2, textures);
+  m->fglGenFramebuffers(1, &fbo);
+  auto releaseGL = MakeScopeExit([&] {
+    m->fglDeleteFramebuffers(1, &fbo);
+    m->fglDeleteTextures(2, textures);
+  });
+  m->fglBindTexture(GL_TEXTURE_2D, textures[1]);
+  m->imageTarget(GL_TEXTURE_2D, dst);
+  m->fglBindFramebuffer(GL_FRAMEBUFFER, fbo);
+  m->fglFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                             GL_TEXTURE_2D, textures[1], 0);
+  if (m->fglCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+    return nullptr;
+  m->fglBindTexture(GL_TEXTURE_EXTERNAL_OES, textures[0]);
+  m->imageTarget(GL_TEXTURE_EXTERNAL_OES, src);
+  m->fglTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER,
+                      GL_LINEAR);
+  m->fglTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER,
+                      GL_LINEAR);
+  m->fglTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S,
+                      GL_CLAMP_TO_EDGE);
+  m->fglTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T,
+                      GL_CLAMP_TO_EDGE);
+  m->fglUseProgram(m->program);
+  m->fglViewport(0, 0, aWidth, aHeight);
+  m->fglUniform4f(m->fglGetUniformLocation(m->program, "crop"),
+                  float(crop.left) / inputDesc.width,
+                  float(crop.top) / inputDesc.height,
+                  float(crop.right - crop.left) / inputDesc.width,
+                  float(crop.bottom - crop.top) / inputDesc.height);
+  const GLfloat vertices[] = {-1, -1, 1, -1, -1, 1, 1, 1};
+  m->fglVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, vertices);
+  m->fglEnableVertexAttribArray(0);
+  m->fglDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+  EGLSyncKHR sync =
+      m->createSync(m->display, EGL_SYNC_NATIVE_FENCE_ANDROID, nullptr);
+  m->fglFlush();
+  if (sync == EGL_NO_SYNC_KHR) {
+    // Error teardown must not return an input still sampled by queued commands.
+    m->fglFinish();
+    return nullptr;
+  }
+  UniqueFileHandle fence(m->dupFence(m->display, sync));
+  releaseFence = m->dupFence(m->display, sync);
+  m->destroySync(m->display, sync);
+  if (!fence || releaseFence < 0) {
+    m->fglFinish();
+    return nullptr;
+  }
+  if (m->fglGetError() != GL_NO_ERROR) return nullptr;
+  UniqueFileHandle fd(dup(slot->fd.get()));
+  if (!fd) {
+    LOG("RGBA AHardwareBuffer has no dma-buf fd");
+    return nullptr;
+  }
+  // Android RGBA byte order is DRM ABGR8888 on little-endian AArch64.
+  RefPtr<DMABufSurfaceRGBA> surface = DMABufSurfaceRGBA::CreateFromBuffer(
+      std::move(fd), std::move(fence), aWidth, aHeight, desc.stride * 4);
+  slot->lastSurface = surface;
+  LOG("GPU blit {}x{} stride {} -> DMABuf {}", aWidth, aHeight, desc.stride,
+      surface->GetUID());
+  RefPtr<layers::Image> result = new layers::DMABUFSurfaceImage(surface);
+  return result.forget();
+}
